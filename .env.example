# OpenAI-compatible LLM service
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://your-api-host.example.com/compatible-mode/v1
LLM_MODEL=your_model_name_here

# Retrieval sources
# frozen_local: local PaSa only; competition_online: enabled open sources below.
RETRIEVAL_PROFILE=competition_online
QUERY_EXECUTION_MODE=live
OPENALEX_API_KEY=your_openalex_api_key_here
SEMANTIC_SCHOLAR_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Optional suffix, for example: filetype:pdf
GOOGLE_SEARCH_QUERY_SUFFIX=
USE_OPENALEX=true
USE_SEMANTIC_SCHOLAR=false
USE_ARXIV=true
USE_GOOGLE_SEARCH=false

# Frozen local PaSa retrieval (used only by RETRIEVAL_PROFILE=frozen_local)
PASA_BM25_INDEX_PATH=models/pasa_bm25/pasa_corpus.sqlite3
PASA_PAPER_ZIP_PATH=data/paper_database/cs_paper_2nd.zip
PASA_ID2PAPER_PATH=data/paper_database/id2paper.json
PASA_CITATION_GRAPH_PATH=models/pasa_citations/pasa_citations.sqlite3
# For frozen local evaluation, temporarily change QUERY_EXECUTION_MODE to frozen.
PASA_QUERY_CACHE_PATH=results/pasa_v2_query_cache/smoke_v3_0_4.jsonl

# Local retrieval settings
BGE_M3_MODEL_PATH=models/bge-m3
RETRIEVAL_USER_AGENT=ScholarAgentV2/0.2

# One-hop citation snowball (local PaSa graph or online S2/OpenAlex)
USE_CITATION_SNOWBALL=false
# Ranking multiplier for candidates introduced only by citation expansion.
CITATION_CHANNEL_WEIGHT=0.70
CITATION_SEED_TOP_K=3
CITATION_FORWARD_TOP_K=30
CITATION_BACKWARD_TOP_K=30
CITATION_FETCH_LIMIT_PER_SEED=50
CITATION_MIN_SEED_SCORE=0.20
CITATION_MIN_NEW_CANDIDATE_RATE=0.10
